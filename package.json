{
  "name": "pocketo",
  "productName": "Pocketo",
  "version": "1.0.0",
  "description": "Pocketo - personal expense tracker. Track your money. Understand your habits. Control your spending.",
  "author": "Pocketo",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.pocketo.desktop",
    "productName": "Pocketo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pocketo"
    }
  }
}
